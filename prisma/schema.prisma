generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  nickname      String   @unique
  passwordHash  String
  avatar        String   @default("👤")
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())
  lastLoginAt   DateTime @default(now())

  // 模块经验值数据（JSON存储）
  moduleData    Json     @default("{\"math\":{\"exp\":0,\"level\":1,\"selectedTitle\":null},\"physics\":{\"exp\":0,\"level\":1,\"selectedTitle\":null},\"cs\":{\"exp\":0,\"level\":1,\"selectedTitle\":null}}")
  displayCategory String? @default("math")

  // 收藏的帖子
  favoritePosts String[] @default([])

  // 关注统计
  followingCount Int      @default(0)
  followerCount  Int      @default(0)

  // 关联
  answers       AnswerRecord[]
  posts         Post[]
  comments      Comment[]
  answerComments AnswerComment[]
  following     Follow[] @relation("UserFollowing")
  followers     Follow[] @relation("UserFollowers")
}

model DailyQuestion {
  id              String   @id @default(uuid())
  moduleId        String
  date            String   // YYYY-MM-DD
  title           String
  content         String
  images          String[] @default([])
  answer          String?
  answerImages    String[] @default([])
  difficulty      Int      @default(3)
  isAutoGenerated Boolean  @default(true)
  createdAt       DateTime @default(now())

  // 关联
  answers         AnswerRecord[]

  @@index([date])
  @@index([moduleId])
}

model AnswerRecord {
  id                String   @id @default(uuid())
  userId            String
  questionId        String
  content           String
  images            String[] @default([])
  submittedAt       DateTime @default(now())
  aiScore           Int      @default(0)
  aiFeedback        String   @default("")
  isCorrect         Boolean  @default(false)
  experienceGained  Int      @default(0)
  isPublic          Boolean  @default(false)
  likes             Int      @default(0)
  likedBy           String[] @default([])

  // 关联
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question          DailyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  comments          AnswerComment[]

  @@index([userId])
  @@index([questionId])
}

model AnswerComment {
  id          String   @id @default(uuid())
  answerId    String
  userId      String
  content     String
  createdAt   DateTime @default(now())

  // 关联
  answer      AnswerRecord @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([answerId])
}

model Post {
  id          String   @id @default(uuid())
  userId      String
  moduleId    String   @default("general")
  title       String
  content     String
  images      String[] @default([])
  createdAt   DateTime @default(now())
  likes       Int      @default(0)
  likedBy     String[] @default([])

  // 关联
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    Comment[]

  @@index([userId])
  @@index([moduleId])
  @@index([createdAt])
}

model Comment {
  id          String   @id @default(uuid())
  postId      String
  userId      String
  content     String
  createdAt   DateTime @default(now())

  // 关联
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// 关注关系表
model Follow {
  id          String   @id @default(uuid())
  followerId  String   // 关注者
  followingId String   // 被关注者
  createdAt   DateTime @default(now())

  // 关联
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId]) // 防止重复关注
  @@index([followerId])
  @@index([followingId])
}
