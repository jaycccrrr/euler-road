generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  nickname      String   @unique
  passwordHash  String
  avatar        String   @default("👤")
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())
  lastLoginAt   DateTime @default(now())

  // 模块经验值数据（JSON存储）
  moduleData    Json     @default("{\"math\":{\"exp\":0,\"level\":1,\"selectedTitle\":null},\"physics\":{\"exp\":0,\"level\":1,\"selectedTitle\":null},\"cs\":{\"exp\":0,\"level\":1,\"selectedTitle\":null}}")
  displayCategory String? @default("math")

  // 收藏的帖子
  favoritePosts String[] @default([])
  // 收藏的每日一题
  favoriteQuestions String[] @default([])
  // π力系统（前端统计，云端持久化）
  piPower       Json?

  // 关注统计
  followingCount Int      @default(0)
  followerCount  Int      @default(0)

  // 关联
  answers       AnswerRecord[]
  posts         Post[]
  comments      Comment[]
  answerComments AnswerComment[]
  following     Follow[] @relation("UserFollowing")
  followers     Follow[] @relation("UserFollowers")
  sentMessages  Message[] @relation("UserSentMessages")
  receivedMessages Message[] @relation("UserReceivedMessages")
  discussionMessages DiscussionMessage[]
  discussionReplies  DiscussionReply[]
  notifications       Notification[]  @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")
}

model DailyQuestion {
  id              String   @id @default(uuid())
  moduleId        String
  date            String   // YYYY-MM-DD
  title           String
  content         String
  images          String[] @default([])
  answer          String?
  answerImages    String[] @default([])
  difficulty      Int      @default(3)
  isAutoGenerated Boolean  @default(true)
  createdAt       DateTime @default(now())

  // 关联
  answers         AnswerRecord[]

  @@index([date])
  @@index([moduleId])
}

model AnswerRecord {
  id                String   @id @default(uuid())
  userId            String
  questionId        String
  content           String
  images            String[] @default([])
  submittedAt       DateTime @default(now())
  aiScore           Int      @default(0)
  aiFeedback        String   @default("")
  isCorrect         Boolean  @default(false)
  experienceGained  Int      @default(0)
  isPublic          Boolean  @default(false)
  likes             Int      @default(0)
  likedBy           String[] @default([])

  // 关联
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question          DailyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  comments          AnswerComment[]

  @@index([userId])
  @@index([questionId])
}

model AnswerComment {
  id          String   @id @default(uuid())
  answerId    String
  userId      String
  content     String
  createdAt   DateTime @default(now())

  // 关联
  answer      AnswerRecord @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([answerId])
}

model Post {
  id          String   @id @default(uuid())
  userId      String
  moduleId    String   @default("general")
  postType    String   @default("general")
  topics      String[] @default([])
  title       String
  content     String
  images      String[] @default([])
  createdAt   DateTime @default(now())
  likes       Int      @default(0)
  likedBy     String[] @default([])

  // 关联
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    Comment[]

  @@index([userId])
  @@index([moduleId])
  @@index([createdAt])
}

model Comment {
  id          String   @id @default(uuid())
  postId      String
  userId      String
  content     String
  createdAt   DateTime @default(now())

  // 关联
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// 关注关系表
model Follow {
  id          String   @id @default(uuid())
  followerId  String   // 关注者
  followingId String   // 被关注者
  createdAt   DateTime @default(now())

  // 关联
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId]) // 防止重复关注
  @@index([followerId])
  @@index([followingId])
}

// 私信消息
model Message {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  content     String
  images      String[] @default([])
  messageType String   @default("text")
  cardPayload Json?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender   User @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("UserReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// 每日挑战讨论区消息
model DiscussionMessage {
  id                  String   @id @default(uuid())
  questionId          String
  userId              String
  content             String
  refQuestionId       String?
  refQuestionTitle    String?
  refQuestionModuleId String?
  refQuestionDate     String?
  refAnswerId         String?
  refAnswerExcerpt    String?
  refAnswerScore      Int?
  refAnswerIsCorrect  Boolean?
  likes               Int      @default(0)
  likedBy             String[] @default([])
  createdAt           DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies DiscussionReply[]

  @@index([questionId])
  @@index([createdAt])
}

// 讨论区消息的回复
model DiscussionReply {
  id              String   @id @default(uuid())
  messageId       String
  userId          String
  content         String
  replyToNickname String?
  likes           Int      @default(0)
  likedBy         String[] @default([])
  createdAt       DateTime @default(now())

  message DiscussionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// 用户反馈
model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  content   String
  page      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 通知中心：点赞 / 评论 / 关注 / 讨论回复等互动通知
model Notification {
  id            String   @id @default(uuid())
  userId        String   // 接收者
  type          String   // post_like / post_comment / answer_like / answer_comment / follow / discussion_reply
  actorId       String   // 触发者
  actorNickname String   @default("")
  actorAvatar   String   @default("")
  targetType    String?  // post / answer / discussion / user
  targetId      String?
  content       String   @default("") // 摘要文本（如评论内容节选）
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  user  User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}
