# Supabase Configuration
# 从 Supabase Dashboard 获取: https://app.supabase.com
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[your-anon-key]"

# JWT Secret (用于API认证)
JWT_SECRET="your-jwt-secret-minimum-32-characters-long"

# DeepSeek API Key（服务端 AI 判卷；https://platform.deepseek.com/ 获取）
DEEPSEEK_API_KEY="your-deepseek-api-key"

# 识图判卷（阿里云百炼，https://bailian.console.aliyun.com 获取；OpenAI 兼容接口）
VISION_API_KEY="your-dashscope-api-key"
# 识图判卷模型（默认 qwen-vl-plus，即 Qwen3-VL-Plus）
VISION_MODEL="qwen-vl-plus"
